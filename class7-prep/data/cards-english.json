      ["always, usually, every day", "Simple present"],
      ["now, at the moment", "Present continuous"],
      ["just, already, yet, ever", "Present perfect"],
      ["since or for (still going on)", "Present perfect continuous"],
      ["tomorrow, next week", "Simple future"],
      ["by 5 p.m., by next year", "Future perfect"],
      ["With he, she, it, the simple present verb adds", "-s or -es (he plays, she goes)"],
